# Used by Drizzle Kit for remote D1 migrations over HTTP.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_DATABASE_ID=
CLOUDFLARE_D1_TOKEN=

# Production Worker URL (set after `bun run deploy:api`)
WORKER_URL=

# Local Worker secrets (copy to .dev.vars — never commit .dev.vars)
JWT_SECRET=
CLOUDINARY_API_SECRET=

# Remote migrations also require: wrangler login
