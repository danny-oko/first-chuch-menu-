{
  "name": "menu-api",
  "type": "module",
  "scripts": {
    "dev": "bun run db:migrate:local && wrangler dev",
    "deploy": "bun run db:migrate:remote && wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "generate": "drizzle-kit generate",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply menu-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply menu-db --remote",
    "db:clear:local": "wrangler d1 execute menu-db --local --file=scripts/clear_data.sql",
    "db:clear:remote": "wrangler d1 execute menu-db --remote --file=scripts/clear_data.sql",
    "db:setup": "bun run db:migrate:local"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.12",
    "jose": "^6.2.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260411.1",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "wrangler": "^4.4.0"
  }
}