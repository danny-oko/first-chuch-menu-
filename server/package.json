{
  "name": "server-preset",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "generate": "drizzle-kit generate",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply server-preset-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply server-preset-db --remote"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.12",
    "jose": "^6.2.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260411.1",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "wrangler": "^4.4.0"
  }
}